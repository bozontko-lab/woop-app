// Cloudflare Workers (static assets): the build in `dist/` is served as is, no Worker code.
// Unknown paths return index.html (SPA), headers come from `public/_headers`.
{
  "name": "woop-app",
  "compatibility_date": "2026-10-01",
  // Public address: woop-app.<account>.workers.dev. No per-version preview URLs (we deploy from main only).
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
